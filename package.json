    "test:frontend": "node tests/pos/test-frontend-pos.js && node tests/orders/test-frontend-orders.js && node tests/payments/test-frontend-payments.js && node tests/procurement/test-frontend-procurement.js && node tests/logistics/test-frontend-drivers.js && node tests/logistics/test-frontend-vehicles.js && node tests/frontend/test-ui-contracts.js",
