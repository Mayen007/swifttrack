{
  "name": "logistics-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "client:dev": "cd client && npm run dev",
    "test": "node tests/verify-system.js",
    "test:shipments": "node tests/logistics/test-shipments-core.js",
    "test:transport": "node tests/logistics/test-transport-runs.js",
    "test:custody": "node tests/logistics/test-physical-custody.js",
    "test:last-mile": "node tests/logistics/test-last-mile-delivery.js",
    "test:pos-counter": "node tests/logistics/test-pos-counter-booking.js",
    "test:cod": "node tests/logistics/test-cod-settlement.js",
    "test:control-tower": "node tests/logistics/test-control-tower.js",
    "test:notifications": "node tests/logistics/test-notifications-engine.js",
    "test:e2e": "node tests/logistics/test-e2e-acceptance.js",
    "test:db": "node tests/verify-db-postgres.js && node tests/database/test-postgres-data-architecture.js",
    "test:all": "node tests/verify-system.js && node tests/logistics/test-shipments-core.js && node tests/logistics/test-transport-runs.js && node tests/logistics/test-physical-custody.js && node tests/logistics/test-last-mile-delivery.js && node tests/logistics/test-pos-counter-booking.js && node tests/logistics/test-cod-settlement.js && node tests/logistics/test-control-tower.js && node tests/logistics/test-notifications-engine.js && node tests/logistics/test-e2e-acceptance.js && node tests/database/test-postgres-data-architecture.js",
    "db:setup": "node -e \"require('./server/db/database.js').initSchema()\"",
    "db:seed:prod": "node server/db/seed.js --prod",
    "db:seed:demo": "node server/db/seed.js",
    "db:seed:branches": "node server/db/seedDemoBranches.js",
    "db:reset:prod": "node server/db/seed.js --clean --prod",
    "db:reset:demo": "node server/db/seed.js --clean",
    "db:backup": "node server/db/backup.js",
    "db:migrate": "node server/db/postgres/migrator.js up",
    "db:migrate:status": "node server/db/postgres/migrator.js status",
    "db:migrate:rollback": "node server/db/postgres/migrator.js rollback",
    "db:pg:seed": "node server/db/postgres/seed.js",
    "db:pg:retention": "node server/db/postgres/retention.js",
    "db:migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
