{
  "name": "logistics-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "client:dev": "cd client && npm run dev",
    "test": "node tests/verify-system.js",
    "db:setup": "node -e \"require('./server/db/database.js').initSchema()\"",
    "db:seed:prod": "node server/db/seed.js --prod",
    "db:seed:demo": "node server/db/seed.js",
    "db:seed:branches": "node server/db/seedDemoBranches.js",
    "db:reset:prod": "node server/db/seed.js --clean --prod",
    "db:reset:demo": "node server/db/seed.js --clean",
    "db:backup": "node server/db/backup.js",
    "db:migrate": "node server/db/postgres/migrator.js up",
    "db:migrate:status": "node server/db/postgres/migrator.js status",
    "db:migrate:rollback": "node server/db/postgres/migrator.js rollback",
    "db:pg:seed": "node server/db/postgres/seed.js",
    "db:pg:retention": "node server/db/postgres/retention.js",
    "db:migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
