# ==============================================================================
# SwiftTrack Logistics Platform - Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# Application Mode:
# Set to 'false' in production to strictly disable demo-switch, sandbox bypasses, and unauthenticated dev shortcuts.
DEMO_MODE=false

# Security & Cryptography
# Generate a cryptographically secure 64+ char secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_cryptographic_hex_secret_in_production
SESSION_EXPIRY=24h

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=https://app.swifttrack.co.ke,https://swifttrack.co.ke,http://localhost:4000

# Rate Limiting Configuration (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=10

# Database Engine Selection ('postgres' authoritative for production, 'sqlite' for local dev / offline testing)
DB_CLIENT=postgres

# PostgreSQL Production Connection (Set DATABASE_URL or individual PG* parameters)
DATABASE_URL=postgres://swifttrack_admin:your_secure_password@localhost:5432/swifttrack_logistics
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=swifttrack_logistics
# PGUSER=swifttrack_admin
# PGPASSWORD=your_secure_password
# PGSSLMODE=require

# PostgreSQL Connection Pool Tuning
PGPOOL_MAX=25
PGPOOL_MIN=5
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONN_TIMEOUT_MS=5000

# SQLite Local Development Path (Used only when DB_CLIENT=sqlite)
DATABASE_PATH=data/logistics_platform.db

# Background Worker & Notification Outbox
WORKER_INTERVAL_MS=15000
