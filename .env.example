# ==============================================================================
# SwiftTrack Kenya Logistics & POS Platform - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Application Mode:
# Set to 'false' in production to disable demo-switch, unauthenticated auto-login, and sandbox shortcuts.
DEMO_MODE=true

# Security & Cryptography
# Generate a secure 64+ char secret for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=swifttrack_jwt_super_secret_production_key_2026_change_in_prod
SESSION_EXPIRY=24h

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4000

# Rate Limiting Configuration (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=15

# Database Configuration
DATABASE_PATH=data/logistics_platform.db
